# SMS Solvers Integration Tests - Environment Variables
#
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# Then run the integration tests with:
#   cargo test --test hero_sms_api -- --ignored
#   cargo test --test sms_online_api -- --ignored
#
# WARNING: Integration tests will consume API credits!

# Hero SMS API key
# Get your API key from: https://hero-sms.com/
HERO_SMS_API_KEY=your_api_key_here

# SMS.online API key
# Get your API key from: https://sms.online/
SMS_ONLINE_API_KEY=your_api_key_here
